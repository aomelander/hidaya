# ==============================================================================
# HIDAYA (هداية) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` or `.dev.vars` for local development.
#
# NOTE: Hidaya includes an automatic zero-config offline mock fallback.
# If keys are omitted or set to placeholders, local development works seamlessly
# using verified in-memory fixtures.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration (Optional for mock mode)
# ------------------------------------------------------------------------------
# Used strictly in Stage 4 of the retrieval engine for bounded situational synthesis.
# The model will NEVER generate Quranic Arabic text or issue fatwas.
#
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Supabase / PostgreSQL Configuration (Optional for mock mode)
# ------------------------------------------------------------------------------
# Used for persistent vector search (pgvector) across all 6,236 Ayahs.
# If omitted or pointing to mock URLs, the local verified fixture dataset is used.
#
# Obtain these from your Supabase project settings: https://app.supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 3. Application Environment Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
